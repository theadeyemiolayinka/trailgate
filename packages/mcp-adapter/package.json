{
  "name": "@trailgate/mcp-adapter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "trailgate-mcp": "./dist/mcp.js"
  },
