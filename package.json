{
  "name": "trailgate",
  "version": "0.0.0",
  "private": true,
  "description": "TrailGate: an experimental protocol for secure, user-consented delegation from users to AI agents and automated clients.",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=11.3"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "verify": "pnpm check && pnpm build && pnpm typecheck && pnpm test",
    "cli": "node packages/agent-cli/dist/cli.js",
    "mcp": "node packages/mcp-adapter/dist/mcp.js",
    "shop": "pnpm --dir apps/example-shop dev",
    "shop:certs": "pnpm --dir apps/example-shop certs",
    "bundle": "pnpm -r build && node scripts/bundle.mjs",
    "embed": "node scripts/embed-schemas.mjs",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm verify && pnpm bundle && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "2.29.8",
    "@types/node": "catalog:",
    "esbuild": "0.25.12",
    "typescript": "catalog:"
  }
}
